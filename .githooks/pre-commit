#!/usr/bin/env bash
# Blokuje commit, jeśli w zmianach jest coś, co wygląda na klucz, token lub hasło.
# Włączany przez:  git config core.hooksPath .githooks   (robi to narzedzia/przygotuj-maca.sh)
set -uo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  for p in /opt/homebrew/bin/gitleaks /usr/local/bin/gitleaks; do [ -x "$p" ] && PATH="$(dirname "$p"):$PATH"; done
fi
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "❌ Brak gitleaks – zainstaluj: brew install gitleaks. Commit zablokowany dla bezpieczeństwa."
  exit 1
fi

if ! gitleaks git --pre-commit --staged --redact --no-banner --log-level warn; then
  echo "❌ gitleaks znalazł możliwy klucz/token w zmianach. Commit zablokowany."
  exit 1
fi

# Druga warstwa: wzorce typowe dla naszych usług (Google, Meta, GitHub, Anthropic/OpenAI)
PAT='(GOCSPX-[A-Za-z0-9_-]{10,}|1//[0-9A-Za-z_-]{30,}|EAA[A-Za-z0-9]{30,}|sk-(ant-|proj-)?[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{30,}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|xox[abp]-[A-Za-z0-9-]{10,}|BEGIN [A-Z ]*PRIVATE KEY)'
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -qE "$PAT"; then
  echo "❌ W zmianach jest ciąg wyglądający na klucz/token. Commit zablokowany."
  exit 1
fi
exit 0
